# Токен ВАШЕГО Telegram-бота из @BotFather (не токен Crypto Pay).
BOT_TOKEN=PASTE_YOUR_BOTFATHER_TOKEN_HERE

# Числовые Telegram ID администраторов, через запятую. Не @username.
# Например: ADMIN_TELEGRAM_IDS=123456789,987654321
ADMIN_TELEGRAM_IDS=REPLACE_WITH_YOUR_TELEGRAM_ID

# Публичный HTTPS адрес, на котором работает ИМЕННО этот Node.js сервер.
# Без / в конце. Не адрес статического превью Sites.
PUBLIC_URL=https://wallet.example.com

# Порт Node.js; при nginx на том же сервере оставьте HOST=127.0.0.1.
# В контейнере обычно HOST=0.0.0.0 и проброс порта 3000.
HOST=127.0.0.1
PORT=3000
NODE_ENV=production

# SQLite: каталог должен быть на постоянном диске с резервным копированием.
DB_PATH=./data/fk-wallet.sqlite

# Максимальный возраст данных Telegram для входа и срок сессии (секунды).
AUTH_MAX_AGE_SECONDS=300
SESSION_TTL_SECONDS=43200

# Включает FK Pay. Сгенерируйте один раз и сохраните вместе с резервной копией БД:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Не меняйте при перезапусках: ключ шифрует webhook-секреты в SQLite.
APP_ENCRYPTION_KEY=

# Username ВАШЕГО бота без @. Нужен для ссылок оплаты из других ботов.
# В @BotFather также настройте Main Mini App с адресом PUBLIC_URL.
TELEGRAM_BOT_USERNAME=

# Crypto Pay ещё не интегрирован: пополнение и вывод в CryptoBot отключены.
# Начисления администратора меняют только внутренний баланс, не создают криптовалюту.
